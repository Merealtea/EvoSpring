build /root/autodl-tmp/EvoSpring/src/gaussian_splatting/submodules/simple-knn/build/temp.linux-x86_64-cpython-312/simple_knn.o: cuda_compile /root/autodl-tmp/EvoSpring/src/gaussian_splatting/submodules/simple-knn/simple_knn.cu
build /root/autodl-tmp/EvoSpring/src/gaussian_splatting/submodules/simple-knn/build/temp.linux-x86_64-cpython-312/spatial.o: cuda_compile /root/autodl-tmp/EvoSpring/src/gaussian_splatting/submodules/simple-knn/spatial.cu








