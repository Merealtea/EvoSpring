ninja_required_version = 1.3
cxx = /home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/bin/x86_64-conda-linux-gnu-g++
nvcc = /home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/include -fPIC -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/lib/python3.10/site-packages/torch/include -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/include -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/include/python3.10 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=_C -std=c++17
cuda_cflags = -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/lib/python3.10/site-packages/torch/include -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/include -I/home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=_C -gencode=arch=compute_120,code=compute_120 -gencode=arch=compute_120,code=sm_120 -ccbin /home/yj401@ad.eng.cam.ac.uk/miniconda3/envs/physpring/bin/x86_64-conda-linux-gnu-gcc -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







